{
  "name": "@community-agent/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:gates": "node scripts/check-gates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "tsx src/db/bootstrap.ts",
    "db:push:drizzle": "drizzle-kit push --force",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "tsx src/db/check.ts"
  },
  "dependencies": {
    "@community-agent/shared": "*",
    "@crowdos/pi-core": "*",
    "@fastify/cors": "^11.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  }
}
