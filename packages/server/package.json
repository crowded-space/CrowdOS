{
  "name": "@crowdspace/server",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-migrations.mjs",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:gates": "node scripts/check-gates.mjs && node scripts/check-redaction.mjs && node scripts/check-events.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "tsx src/db/bootstrap.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "tsx src/db/check.ts",
    "db:encrypt-secrets": "tsx src/db/backfill-encrypt-secrets.ts",
    "gen:env-doc": "tsx scripts/generate-env-doc.mjs"
  },
  "dependencies": {
    "@crowdspace/shared": "*",
    "@crowdspace/pi-core": "*",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "bullmq": "^6.2.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  }
}
