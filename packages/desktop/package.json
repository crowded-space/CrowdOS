{
  "name": "@crowdspace/desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Electron desktop shell for CrowdOS (Windows-first, zero-auth, loopback-only).",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:preload",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:preload": "npx esbuild preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload/index.cjs --external:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "dev": "node scripts/dev-electron.mjs",
    "dev:electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "electron": ">=44"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
