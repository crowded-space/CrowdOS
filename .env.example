PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/community_agent

# Core — NODE_ENV: Runtime mode.
# CONFIG_STRICT: Rollback switch for CFG-1 fail-fast boot: false downgrades unknown project-prefixed env vars from boot-blocking errors to warnings.
# HOST: Optional bind host for the HTTP listener (reserved; listener currently binds default host). CORS_ORIGIN alias reserved; CLIENT_ORIGIN is the consumed var.
# SYSTEM_ACTOR_ID: Actor id attributed to system-generated messages and fallback ownership. WORKSPACE_DIR overrides sandbox root.
NODE_ENV=development
CONFIG_STRICT=true
# HOST=
# CORS_ORIGIN=
SYSTEM_ACTOR_ID=system
# WORKSPACE_DIR=

# SEC-1 key-based auth (strict-only default-deny): all routes
# require a valid API key (Authorization: Bearer <key>, X-API-Key, or ?api_key=).
# /health stays unauthenticated. On boot the server seeds one admin API key if
# none exists and prints it ONCE to stdout — copy it then, it is never shown
# or stored in plaintext again.

# Admin token gating privileged routes (/metrics, DB config mutation)
# WORKSPACE_ADMIN_TOKEN=

# SEC-4 encrypt-at-rest for provider credentials (model module / profile
# api_key columns, mcp_servers.env_vars values). AES-256-GCM envelope format:
# enc:v1:<iv_b64>:<tag_b64>:<ct_b64>. Accepts 32-byte hex (openssl rand -hex 32,
# preferred), 32-byte base64, or any passphrase (scrypt-derived). UNSET =
# encryption disabled: new credentials are written as plaintext and stored
# envelopes pass through unchanged. Rotate = decrypt all, re-encrypt with the
# new key (envelopes carry no key id in v1).
CREDENTIALS_ENCRYPTION_KEY=

# SEC-5 HTTP rate limiting (@fastify/rate-limit, in-memory per-key buckets).
# RATE_LIMIT_ENABLED=false disables all HTTP limiting (rollback).
# RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS size the global bucket (per API key,
# or per IP when unauthenticated). /health and /api/health are always exempt.
# Strict routes (/api/tools/execute-test, /api/studio/inspect-prompt) use a
# fixed 10 requests / 60s bucket regardless of these values.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# SEC-2 sockets.
# SOCKET_MSG_RATE_* controls per-socket token-bucket for user-content events.
SOCKET_MSG_RATE_CAPACITY=15
SOCKET_MSG_RATE_REFILL=5
# D6: DURABLE_EVENTS retired (always off). Kept so old env files still parse.
DURABLE_EVENTS=false

# D1/C1: MAX_PARALLEL_AGENTS ignored — multi-mention is always serial per §10.
# Kept so old env files still parse.
MAX_PARALLEL_AGENTS=4

# Provider timeouts. 0 disables the watchdog.
PROVIDER_CONNECT_TIMEOUT_MS=10000
PROVIDER_IDLE_TIMEOUT_MS=120000
# Undici keep-alive tuning (only if undici resolvable; otherwise Node fetch pools by default)
PROVIDER_KEEP_ALIVE_TIMEOUT_MS=10000
PROVIDER_KEEP_ALIVE_MAX_TIMEOUT_MS=60000
PROVIDER_PIPELINING=4
PROVIDER_MAX_CONNECTIONS=8

# PERF-6 stream coalescing. STREAM_BATCH_MS=0 disables batching (immediate per-chunk flush).
STREAM_BATCH_MS=50
# Context pipeline parallelism; false forces serial execution (rollback)
PIPELINE_PARALLEL=true
# Heartbeat orphan threshold in ms; agents still 'working' with lastHeartbeat older than this are paused as orphaned (minimum 10000).
ORPHAN_AFTER_MS=60000
# PERF-3 per-iteration budget: enforce per-iteration context budget in agentic runtime; false restores assembly-time-only capping.
PER_ITERATION_BUDGET=true

# Memories
MEM_SUPPRESS_SWEEP_MS=600000
MEM_NOTE_CAP=500
MEM_DISCARD_TTL_MS=1800000
MEM_REFLECT_THROTTLE=true
MEM_REFLECT_MIN_INTERVAL_MS=60000
MEM_REFLECT_SIMILARITY_PCT=80
MEM_RETRIEVAL_WINDOW=60

# Spawn retention
RETENTION_SWEEP_MS=21600000
RETENTION_DAYS=30

# PERF-4 budget ledger reconcile interval in ms (default 24h). The daily job
# recomputes workspace budget consumption FROM token_usage_log, keeping the
# O(n) SUM off the per-completion hot path.
BUDGET_RECONCILE_MS=86400000

# PERF-8 tool read/write parallelization; false restores legacy all-or-nothing batch scheduling.
TOOL_RWP=true
TOOL_RWP_MAX_READ_CONCURRENCY=4
# Tool safety legacy-guard switch; true enables conservative legacy rules.
LEGACY_GUARD=false

# PERF-4 librarian delta indexing. DELTA_INDEX=true (default) summarizes only
# messages past channel_index.last_seq (first run seeds from the full window);
# DELTA_INDEX=false rolls back to the legacy full-reload summarization window.
DELTA_INDEX=true

# RT-4 honest compression. HONEST_COMPACTION=true (default) summarizes dropped
# turns via the cheap-tier model (fallback: honest `[truncated N turns: seq X..Y]`
# marker persisted to compressed_summaries and inline). HONEST_COMPACTION=false
# keeps pure truncation without a model call (rollback). Alias COMPACTION_SUMMARIZE
# is also accepted. Requires MODEL-1 cheap tier for summarization.
HONEST_COMPACTION=true
# COMPACTION_SUMMARIZE=true

# MODEL-1 model routing economy v1. MODEL_ROUTE=static bypasses the routing
# table entirely (legacy per-agent module selection). Unset or any other value
# enables task-class tier routing (librarian/reflection pinned to flash tier;
# chat/classify/summarize prefer flash; planning/coding prefer frontier) with a
# deterministic cheapest-capable fallback chain to the agent's pinned module.
MODEL_ROUTE=routed

# Runs ledger persistence; false makes createRun a no-op (rollback switch).
RUNS_ENABLED=true
# OBS-1 /metrics route exposure; false removes the route entirely.
METRICS_ENABLED=true

# DB bootstrap legacy path switch; true forces pre-migration bootstrap sequence.
LEGACY_BOOTSTRAP=false
# Workspace route escape hatch allowing live DATABASE_URL mutation via API; requires WORKSPACE_ADMIN_TOKEN.
ENABLE_DB_CONFIG_MUTATION=false

# QUE-1/2/3 durable execution: QUEUE_MODE=inline (default) runs jobs synchronously
# in-process (no Redis). QUEUE_MODE=bullmq enqueues to Redis/BullMQ and the
# worker process executes them durably with retries, idempotency, DLQ, drain.
# REDIS_URL is only read when QUEUE_MODE=bullmq; jobs are otherwise no-ops and
# no Redis connection is ever opened.
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379

# TOOL-1 honest tools — rollback via unregister (fake never restored):
# QUERY_DATABASE_ENABLED=false unregisters query_database entirely (instead of returning canned agents);
# SYSTEM_SCHEDULER_ENABLED=false unregisters system_scheduler entirely (instead of setTimeout console.log).
# Both default true: query_database → real read-only SQL (pooled, statement_timeout 5s, allowlist, row cap 100);
# system_scheduler → BullMQ delayed/repeatable jobs firing real mentions/events via EventBroker.
# Alternative documented disposition: tools may be removed/unregistered if unwanted (rollback = unregister).
QUERY_DATABASE_ENABLED=true
SYSTEM_SCHEDULER_ENABLED=true

# RT-1 Research runtime — real web search + isolated sub-runs + evidence bundle + cited synthesis
# SearchProviders domain: Brave/Tavily/Serper adapters behind one interface; keys via config.
# At least one key enables real web search; without keys providers return [] gracefully (log + fallback).
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# Optional priority override comma-separated (default: brave,tavily,serper)
# SEARCH_PROVIDER_PRIORITY=brave,tavily,serper
# RT-1 rollback: RESEARCH_V1=false (default) pins research→agentic alias; true enables real ResearchRuntime.
RESEARCH_V1=false

# APR-1 Approval engine — evidence ASK hard-denied (Guard.ts:143-150) now tri-state.
# APPROVALS_ENABLED=false (default) → ASK behaves as DENY (today, rollback).
# APPROVALS_ENABLED=true → risky classes (install/network/destructive/git_push/db_write) pause
#  run WAITING_FOR_APPROVAL, emit approval.requested, await approval.decided via
#  REST POST /api/approvals/:id/decision {decision: approved|denied, scope?} (operator role)
#  or socket approval:decide; TTL default-deny resumes-as-denied; reusable grants cached
#  per (tool,scope-hash) with expiry; full audit trail via approval_requests.
#  Risk class enum install|network|destructive|git_push|db_write|general mapped from tool danger/Guard verdict.
#  Policy: deny/expired → tool fails safely, run continues (does not cancel).
APPROVALS_ENABLED=false
# TTL for pending approvals before auto-expire (default-deny). Reusable grant cache window.
# APPROVAL_TTL_MS=300000
# APPROVAL_REUSABLE_TTL_MS=3600000

# SW-1 Swarm v1 — real DAG supervisor, worker runs (BullMQ inline, leases reuse heartbeats), aggregator, verifier.
# SWARM_V1=false (default) routes L2→agentic rollback; true enables supervisor→swarm_tasks DAG→leaf workers→aggregate→verify→report.
SWARM_V1=false
# SW-2 Delegation contracts — central dispatcher enforces depth≤2 + visited-set cycle rejection; child result summarized (maxSubagentReturnTokens≈500) + artifact pointer; delegation:start/completed events consumed by UI timeline.
# SWARM_MAX_DEPTH=2 (default) max delegation depth before rejection; 99 disables depth guard (dev rollback, cycle guard still enforced).
SWARM_MAX_DEPTH=2
DEMO_FALLBACK=false

# SCL-3 OTel + cost ledger — OTel SDK spans assemble/llm/tool/persist keyed runId; per-run cost rollup view from token_usage_log×cost_per_1k
# OTEL_ENABLED=false (default) disables OTel SDK; true enables @opentelemetry/api tracer.
OTEL_ENABLED=false

# SCL-2 Semantic memory — pgvector hybrid lane scoring
# EMBEDDING_ENABLED=false (default) heuristic-only; true enables pgvector vector(1536) + hybrid weight.
# EMBEDDING_MODEL overrides embeddingModelProfiles row; EMBEDDING_DIMENSIONS must match vector column.
# EMBEDDING_HYBRID_WEIGHT 0..1 (0=heuristic only, 1=vector only; 0.5 = balanced)
EMBEDDING_ENABLED=false
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1536
EMBEDDING_HYBRID_WEIGHT=0.5

# CFG-1 strictness rollback: false downgrades unknown project-prefixed env vars from boot-blocking errors to warnings.
# CONFIG_STRICT=true is the default (already documented above).
# CONFIG_STRICT=false
