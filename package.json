{
  "name": "crowdos",
  "version": "0.1.0",
  "private": true,
  "description": "Operating system for collective intelligence.",
  "workspaces": [
    "packages/server",
    "packages/client",
    "packages/shared",
    "packages/pi-core"
  ],
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:server": "npm run dev --workspace @community-agent/server",
    "dev:client": "npm run dev --workspace @community-agent/client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push --workspace @community-agent/server",
    "db:seed": "npm run db:seed --workspace @community-agent/server",
    "db:check": "npm run db:check --workspace @community-agent/server",
    "db:bootstrap": "npm run db:push && npm run db:seed"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "governance",
    "collective-intelligence"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  }
}
